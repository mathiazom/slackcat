# Local dev env vars for running slackpack/slackback natively against `docker-compose.yml`.
# Copy to .env (git-ignored) and fill in the Slack credentials.
# Each app reads these directly (or via its own naming convention, noted below) -
# there's no shared config loader, so export these however your run/debug setup expects.

# Postgres (matches docker-compose.yml) - used as-is by slackpack (DATABASE_CONNECTION_STRING)
DATABASE_CONNECTION_STRING=postgres://slackcat:slackcat@localhost:5432/slackcat
# same database, .NET connection-string form - used by slackback (ConnectionStrings:Postgres)
# quoted because it contains semicolons, which `source` would otherwise split on
ConnectionStrings__Postgres="Host=localhost;Port=5432;Username=slackcat;Password=slackcat;Database=slackcat"

# SeaweedFS (matches docker-compose.yml) - used as-is by slackpack (SEAWEEDFS_MASTER_URL)
SEAWEEDFS_MASTER_URL=http://localhost:9333
# read by slackback (SeaweedFs:PublicUrl) to build file URLs - relative, as in production,
# where the auth gate serves files under /files (slackopy's dev server proxies it the same way)
SeaweedFs__PublicUrl=/files

# Slack credentials for the workspace being archived (xoxc token + "d" session cookie)
SLACK_AUTH_TOKEN=
SLACK_AUTH_COOKIE=

# slackback's own dev URL (matches Properties/launchSettings.json's "http" profile) - read by slackopy (BACKEND_URL)
BACKEND_URL=http://localhost:5073

